# agent-workspace:v8:start
# Python bytecode cache (any directory, not just the hook runtime -- this
# framework's own repo ships real Python source under lib/, and running any
# python3 command against it generates __pycache__/*.pyc that must never be
# committed).
__pycache__/
*.pyc

# Agent workspace local state
.agents/state/
CLAUDE.local.md

# Optional generated indexes
graphify-out/cache/
# agent-workspace:v8:end

# User-owned (not managed by agent-workspace regen) -- kept local-only, never
# committed: session-continuity state and conversation-prep notes.
docs/CURRENT_STATE.md
docs/work/professor-pitch.md

# This is a graded academic deliverable: only the evaluator-facing content is
# published (README, parte-1/, parte-2/, DECISOES.md, verificacao/, and the
# real project docs below). Agent Workspace tooling and generic templates are
# kept for local use but never committed -- same policy as the vulnpulse repo.
AGENTS.md
CLAUDE.md
.agents/
.claude/
.codex/
.claudeignore
.gitignore.agent-workspace
docs/COMMANDS.md
docs/TOOL_POLICY.md
docs/WORKFLOW.md
docs/decisions/ADR_TEMPLATE.md
docs/specs/
docs/work/TASK_TEMPLATE.md

# --- Terraform ---------------------------------------------------------------
# Provider plugins and local state: regenerated by `terraform init`.
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log

# Generated by scripts/bootstrap.sh from the bootstrap stack's outputs.
# Never committed: it embeds the AWS account ID.
parte-1/backend.hcl

# Local variable overrides. The .example file IS committed.
*.tfvars
!*.tfvars.example

# NOTE: .terraform.lock.hcl is intentionally NOT ignored. It pins provider
# versions and hashes, so the evaluator resolves the same providers we did.

# --- Local-only working material (never committed) ---------------------------
# Talk track for the presentation and the walkthrough docs: personal working
# material, not part of the graded deliverable.
docs/presentation/speaker-notes.pt-BR.md
docs/work/project-explained.md
docs/work/project-explained.pt-BR.md
